{
  "name": "@xc-body/openclaw-native-integration",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": ">=2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning build.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  }
}
