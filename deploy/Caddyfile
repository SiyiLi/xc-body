{
	default_sni {$XC_BODY_PUBLIC_HOST}
}

{$XC_BODY_PUBLIC_HOST} {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	handle_path /xc-body/* {
		reverse_proxy pending:8770
	}
	handle_path /gateway-mcp/* {
		reverse_proxy gateway:8767
	}
	handle_path /firmware/* {
		root * /srv/firmware
		file_server
	}
	handle /avatar_set/* {
		reverse_proxy gateway:8766
	}
	handle /opus {
		reverse_proxy gateway:8766
	}
	handle {
		reverse_proxy gateway:8765
	}
}
