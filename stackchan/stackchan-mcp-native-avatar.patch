+def _framed_opus(*packets: bytes) -> bytes:
+    return b"".join(len(packet).to_bytes(2, "big") + packet for packet in packets)
+
+
+_OPUS_PACKET = bytes.fromhex(
+    "5802f9304dbb0de5e392098938ebcae1b1d1dd85"
+)
+
+
+def test_prepared_opus_parser_accepts_exact_framed_packets():
+    from stackchan_mcp.capture_server import _parse_prepared_opus
+
+    payload = _framed_opus(_OPUS_PACKET, _OPUS_PACKET)
+
+    assert _parse_prepared_opus(payload) == [_OPUS_PACKET, _OPUS_PACKET]
+
+
+@pytest.mark.parametrize(
+    ("packet", "message"),
+    (
+        (b"\x08x", "exactly 60 ms"),
+        (bytes((_OPUS_PACKET[0] | 0x04,)) + _OPUS_PACKET[1:], "mono"),
+        (b"\x5b", "frame count"),
+    ),
+)
+def test_prepared_opus_parser_rejects_wrong_profile(packet, message):
+    from stackchan_mcp.capture_server import (
+        PreparedOpusValidationError,
+        _parse_prepared_opus,
+    )
+
+    with pytest.raises(PreparedOpusValidationError, match=message):
+        _parse_prepared_opus(_framed_opus(packet))
+
+
+@pytest.mark.parametrize(
+    ("payload", "message"),
+    (
+        (b"", "empty"),
+        (b"\x00", "trailing bytes"),
+        (b"\x00\x00", "must not be empty"),
+        (b"\x00\x02x", "ends inside a packet"),
+        (
+            (1276).to_bytes(2, "big") + b"x" * 1276,
+            "packet exceeds",
+        ),
+    ),
+)
+def test_prepared_opus_parser_rejects_malformed_framing(payload, message):
+    from stackchan_mcp.capture_server import (
+        PreparedOpusValidationError,
+        _parse_prepared_opus,
+    )
+
+    with pytest.raises(PreparedOpusValidationError, match=message):
+        _parse_prepared_opus(payload)
+
