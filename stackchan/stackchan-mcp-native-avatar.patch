+@pytest.mark.asyncio
+async def test_prepared_opus_playback_is_locked_bracketed_and_paced(
+    monkeypatch,
+):
+    import asyncio
+    import stackchan_mcp.capture_server as capture_server
+
+    events = []
+    sleeps = []
+
+    class FakeESP32:
+        def __init__(self):
+            self.tts_lock = asyncio.Lock()
+
+        async def send_tts_state(self, state):
+            assert self.tts_lock.locked()
+            events.append(("tts", state))
+
+        async def send_audio_frame(self, packet):
+            assert self.tts_lock.locked()
+            events.append(("frame", packet))
+
+    class FakeGateway:
+        def __init__(self):
+            self.esp32 = FakeESP32()
+
+    async def record_sleep(delay):
+        sleeps.append(delay)
+
+    monkeypatch.setattr(capture_server.asyncio, "sleep", record_sleep)
+
+    await capture_server._play_prepared_opus(
+        FakeGateway(),
+        [b"first", b"second"],
+    )
+
+    assert events == [
+        ("tts", "start"),
+        ("frame", b"first"),
+        ("frame", b"second"),
+        ("tts", "stop"),
+    ]
