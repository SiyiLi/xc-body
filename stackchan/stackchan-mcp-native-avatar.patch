+@pytest.mark.asyncio
+async def test_prepared_opus_retry_is_suppressed_while_id_retained(
+    monkeypatch,
+):
+    from aiohttp.test_utils import TestClient, TestServer
+    import stackchan_mcp.capture_server as capture_server
+
+    plays = []
+
+    async def record_play(gateway, packets):
+        del gateway
+        plays.append(packets)
+
+    monkeypatch.setattr(capture_server, "_play_prepared_opus", record_play)
+    app = create_capture_app(pcm_token="secret", gateway=object())
+    headers = {
+        "Authorization": "Bearer secret",
+        "Content-Type": "application/octet-stream",
+        "X-Message-Id": "eval:lost-response",
+    }
+
+    async with TestClient(TestServer(app)) as client:
+        first = await client.post(
+            "/opus",
+            data=_framed_opus(_OPUS_PACKET),
+            headers=headers,
+        )
+        assert first.status == 200
+        first.release()  # Model losing the completed response before reading it.
+        retry = await client.post(
+            "/opus",
+            data=_framed_opus(_OPUS_PACKET),
+            headers=headers,
+        )
+        assert retry.status == 200
+        assert (await retry.json())["ok"] is True
+
+    assert plays == [[_OPUS_PACKET]]
+
+
+@pytest.mark.asyncio
+async def test_prepared_opus_concurrent_duplicate_is_coalesced(monkeypatch):
+    import asyncio
+    from aiohttp.test_utils import TestClient, TestServer
+    import stackchan_mcp.capture_server as capture_server
+
+    plays = []
+
+    async def record_play(gateway, packets):
+        del gateway
+        plays.append(packets)
+        await asyncio.sleep(0)
+
+    monkeypatch.setattr(capture_server, "_play_prepared_opus", record_play)
+    app = create_capture_app(pcm_token="secret", gateway=object())
+    headers = {
+        "Authorization": "Bearer secret",
+        "Content-Type": "application/octet-stream",
+        "X-Message-Id": "eval:concurrent",
+    }
+
+    async with TestClient(TestServer(app)) as client:
+        responses = await asyncio.gather(
+            client.post(
+                "/opus", data=_framed_opus(_OPUS_PACKET), headers=headers
+            ),
+            client.post(
+                "/opus", data=_framed_opus(_OPUS_PACKET), headers=headers
+            ),
+        )
+        assert [response.status for response in responses] == [200, 200]
+
+    assert plays == [[_OPUS_PACKET]]
