+async def test_load_avatar_set_accepts_supported_payload_sizes(
+    monkeypatch, tmp_path, mode, size
+):
+    import stackchan_mcp.gateway as gw_mod
+
+    payload = tmp_path / "avatar.rgb565le"
+    payload.write_bytes(b"x" * size)
+    gateway = Gateway()
+    gateway._capture_app = object()
+    monkeypatch.setattr(
+        gw_mod,
+        "stage_avatar_set",
+        lambda app, staged_mode, data: _stage_result(
+            app, staged_mode, data, mode, size
+        ),
+    )
+
+    class FakeEsp32:
+        async def send_avatar_set_fetch(self, **kwargs):
+            assert kwargs["mode"] == mode
+            assert kwargs["expected_size"] == size
+            return {"ok": True, "checksum": kwargs["checksum"]}
+
+    gateway.esp32 = FakeEsp32()
+    result = await gateway.load_avatar_set(str(payload), mode)
+
+    assert result["ok"] is True
+    assert result["bytes_transferred"] == size
+
+
+async def _stage_result(app, staged_mode, data, expected_mode, expected_size):
+    assert app is not None
+    assert staged_mode == expected_mode
+    assert len(data) == expected_size
+    return "short-id", "token", "sha256:test"
+
