+class PreparedOpusValidationError(ValueError):
+    """A prepared Opus body does not match the framed wire contract."""
+
+
+class PreparedOpusTooLargeError(PreparedOpusValidationError):
+    """A prepared Opus body exceeds its bounded upload size."""
+
+
+def _validate_prepared_opus_message_id(message_id: str) -> None:
+    """Require the pending-thought recent-ID key contract."""
+
+    if (
+        not 1 <= len(message_id) <= 128
+        or message_id[0] not in _MESSAGE_ID_FIRST_CHARS
+        or any(character not in _MESSAGE_ID_CHARS for character in message_id)
+    ):
+        raise PreparedOpusValidationError(
+            "X-Message-Id has an invalid format"
+        )
+
+
+def _validate_prepared_opus_packet(packet: bytes) -> None:
+    """Check the mono flag and duration exposed by an Opus packet TOC.
+
+    The producer guarantees raw Opus encoded from 16 kHz mono PCM. The raw
+    packet does not expose that PCM input rate, and this check does not claim
+    that an Opus decoder will accept arbitrary bytes with a matching TOC.
+    """
+
+    if packet[0] & 0x04:
+        raise PreparedOpusValidationError(
+            "prepared Opus packets must declare mono"
+        )
+    duration_ms = _opus_packet_duration_ms(packet)
+    if duration_ms != PREPARED_OPUS_FRAME_DURATION_MS:
+        raise PreparedOpusValidationError(
+            "prepared Opus packets must contain exactly 60 ms "
+            f"(got {duration_ms:g} ms)"
+        )
+
+
+def _opus_packet_duration_ms(packet: bytes) -> float:
+    """Return duration from the Opus TOC without claiming decodability."""
+
+    toc = packet[0]
+    config = toc >> 3
+    if config < 12:
+        frame_duration_ms = (10, 20, 40, 60)[config & 0x03]
+    elif config < 16:
+        frame_duration_ms = (10, 20)[config & 0x01]
+    else:
+        frame_duration_ms = (2.5, 5, 10, 20)[config & 0x03]
+
+    frame_code = toc & 0x03
+    if frame_code == 0:
+        frame_count = 1
+    elif frame_code in (1, 2):
+        frame_count = 2
+    else:
+        if len(packet) < 2:
+            raise PreparedOpusValidationError(
+                "prepared Opus packet omits its frame count"
+            )
+        frame_count = packet[1] & 0x3F
+        if frame_count == 0:
+            raise PreparedOpusValidationError(
+                "prepared Opus packet has zero frames"
+            )
+    return frame_duration_ms * frame_count
+
+
+def _parse_prepared_opus(payload: bytes) -> list[bytes]:
+    """Parse framing and validate byte-verifiable Opus profile facts."""
+
+    if not payload:
+        raise PreparedOpusValidationError("prepared Opus body is empty")
+    if len(payload) > PREPARED_OPUS_MAX_TOTAL_BYTES:
+        raise PreparedOpusTooLargeError(
+            "prepared Opus body exceeds "
+            f"{PREPARED_OPUS_MAX_TOTAL_BYTES} bytes"
+        )
+
+    packets: list[bytes] = []
+    offset = 0
+    while offset < len(payload):
+        if len(packets) >= PREPARED_OPUS_MAX_PACKETS:
+            raise PreparedOpusValidationError(
+                "prepared Opus body exceeds "
+                f"{PREPARED_OPUS_MAX_PACKETS} packets"
+            )
+        remaining = len(payload) - offset
+        if remaining < 2:
+            raise PreparedOpusValidationError(
+                "prepared Opus body has trailing bytes after final packet"
+            )
+        packet_size = int.from_bytes(payload[offset : offset + 2], "big")
+        offset += 2
+        if packet_size == 0:
+            raise PreparedOpusValidationError(
+                "prepared Opus packet must not be empty"
+            )
+        if packet_size > PREPARED_OPUS_MAX_PACKET_BYTES:
+            raise PreparedOpusValidationError(
+                "prepared Opus packet exceeds "
+                f"{PREPARED_OPUS_MAX_PACKET_BYTES} bytes"
+            )
+        packet_end = offset + packet_size
+        if packet_end > len(payload):
+            raise PreparedOpusValidationError(
+                "prepared Opus body ends inside a packet"
+            )
+        packet = payload[offset:packet_end]
+        _validate_prepared_opus_packet(packet)
+        packets.append(packet)
+        offset = packet_end
+
+    if offset != len(payload):
+        raise PreparedOpusValidationError(
+            "prepared Opus body has trailing data"
+        )
+    return packets
+
+
+async def _read_prepared_opus_body(request: web.Request) -> bytes:
+    """Read a bounded request body even when Content-Length is absent."""
+
+    content_length = request.content_length
+    if (
+        content_length is not None
+        and content_length > PREPARED_OPUS_MAX_TOTAL_BYTES
+    ):
+        raise PreparedOpusTooLargeError(
+            "prepared Opus body exceeds "
+            f"{PREPARED_OPUS_MAX_TOTAL_BYTES} bytes"
+        )
+
+    payload = bytearray()
+    async for chunk in request.content.iter_chunked(8192):
+        payload.extend(chunk)
+        if len(payload) > PREPARED_OPUS_MAX_TOTAL_BYTES:
+            raise PreparedOpusTooLargeError(
+                "prepared Opus body exceeds "
+                f"{PREPARED_OPUS_MAX_TOTAL_BYTES} bytes"
+            )
+    return bytes(payload)
+
+
+async def _play_prepared_opus(gateway: "Gateway", packets: list[bytes]) -> None:
+    """Play one validated packet sequence on the shared device audio path."""
+
+    esp32 = gateway.esp32
+    tts_lock = getattr(esp32, "tts_lock", None)
+    if tts_lock is None:
+        raise RuntimeError("Gateway does not expose the TTS playback lock")
+
+    async with tts_lock:
+        started = False
+        try:
+            await esp32.send_tts_state("start")
+            started = True
+            await asyncio.sleep(PREPARED_OPUS_START_DELAY_S)
+            loop = asyncio.get_running_loop()
+            next_send_time = loop.time()
+            for packet in packets:
+                delay = next_send_time - loop.time()
+                if delay > 0:
+                    await asyncio.sleep(delay)
+                await esp32.send_audio_frame(packet)
+                next_send_time = max(next_send_time, loop.time())
+                next_send_time += PREPARED_OPUS_FRAME_DURATION_MS / 1000
+        finally:
+            if started:
+                try:
+                    await esp32.send_tts_state("stop")
+                except ConnectionError:
+                    pass
+
+
+async def handle_prepared_opus(request: web.Request) -> web.Response:
+    """Play encoded Opus with bounded process-local duplicate suppression."""
+
+    expected_token = request.app[PCM_TOKEN_KEY]
+    if not _is_authorized(
+        request.headers.get("Authorization", ""), expected_token
+    ):
+        logger.warning("Prepared Opus upload auth rejected")
+        return web.json_response({"error": "Unauthorized"}, status=401)
+    if request.content_type != "application/octet-stream":
+        return web.json_response(
+            {"error": "Content-Type must be application/octet-stream"},
+            status=415,
+        )
+
+    message_id = request.headers.get("X-Message-Id", "")
+    try:
+        _validate_prepared_opus_message_id(message_id)
+    except PreparedOpusValidationError as exc:
+        return web.json_response({"error": str(exc)}, status=400)
+
+    gateway = request.app[GATEWAY_KEY]
+    if gateway is None:
+        return web.json_response({"error": "Gateway not available"}, status=503)
+
+    try:
+        payload = await _read_prepared_opus_body(request)
+        packets = _parse_prepared_opus(payload)
+    except PreparedOpusTooLargeError as exc:
+        return web.json_response({"error": str(exc)}, status=413)
+    except PreparedOpusValidationError as exc:
+        return web.json_response({"error": str(exc)}, status=400)
+
+    results = request.app[PREPARED_OPUS_RESULTS_KEY]
+    async with request.app[PREPARED_OPUS_LOCK_KEY]:
+        cached = results.get(message_id)
+        if cached is not None:
+            logger.info(
+                "Prepared Opus duplicate suppressed: message_id=%s",
+                message_id,
+            )
+            return web.json_response(cached)
+        try:
+            await _play_prepared_opus(gateway, packets)
+        except ConnectionError as exc:
+            return web.json_response(
+                {"error": f"Device unavailable: {exc}"},
+                status=503,
+            )
+        except RuntimeError as exc:
+            return web.json_response({"error": str(exc)}, status=500)
+
+        result = {
+            "ok": True,
+            "packet_count": len(packets),
+            "duration_ms": len(packets) * PREPARED_OPUS_FRAME_DURATION_MS,
+        }
+        results[message_id] = result
+        while len(results) > PREPARED_OPUS_MAX_RECORDED_IDS:
+            results.pop(next(iter(results)))
+
+    logger.info(
+        "Prepared Opus played: message_id=%s packets=%d bytes=%d",
+        message_id,
+        len(packets),
+        len(payload),
+    )
+    return web.json_response(result)
+
+
