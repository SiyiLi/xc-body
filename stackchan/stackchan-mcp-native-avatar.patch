+@pytest.mark.asyncio
+async def test_prepared_opus_eviction_allows_replay(monkeypatch):
+    from aiohttp.test_utils import TestClient, TestServer
+    import stackchan_mcp.capture_server as capture_server
+
+    plays = []
+
+    async def record_play(gateway, packets):
+        del gateway
+        plays.append(packets)
+
+    monkeypatch.setattr(capture_server, "_play_prepared_opus", record_play)
+    monkeypatch.setattr(capture_server, "PREPARED_OPUS_MAX_RECORDED_IDS", 2)
+    app = create_capture_app(pcm_token="secret", gateway=object())
+    headers = {
+        "Authorization": "Bearer secret",
+        "Content-Type": "application/octet-stream",
+    }
+
+    async with TestClient(TestServer(app)) as client:
+        for index in range(3):
+            headers["X-Message-Id"] = f"eval:bounded:{index}"
+            response = await client.post(
+                "/opus",
+                data=_framed_opus(_OPUS_PACKET),
+                headers=headers,
+            )
+            assert response.status == 200
+        headers["X-Message-Id"] = "eval:bounded:0"
+        replay = await client.post(
+            "/opus",
+            data=_framed_opus(_OPUS_PACKET),
+            headers=headers,
+        )
+        assert replay.status == 200
+
+    assert list(app[capture_server.PREPARED_OPUS_RESULTS_KEY]) == [
+        "eval:bounded:2",
+        "eval:bounded:0",
+    ]
+    assert plays == [[_OPUS_PACKET]] * 4
