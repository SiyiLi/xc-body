+def test_prepared_opus_parser_enforces_total_and_packet_count_limits():
+    from stackchan_mcp.capture_server import (
+        PREPARED_OPUS_MAX_PACKETS,
+        PREPARED_OPUS_MAX_TOTAL_BYTES,
+        PreparedOpusTooLargeError,
+        PreparedOpusValidationError,
+        _parse_prepared_opus,
+    )
+
+    with pytest.raises(PreparedOpusTooLargeError):
+        _parse_prepared_opus(b"x" * (PREPARED_OPUS_MAX_TOTAL_BYTES + 1))
