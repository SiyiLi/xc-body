{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xc-body.local/contracts/embodiment-intent.v1.schema.json",
  "title": "XC Body Milestone 1 Embodiment Intent",
  "description": "A semantic request from OpenClaw to its physical StackChan body.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "intent"
  ],
  "properties": {
    "version": {
      "const": "v1"
    },
    "intent": {
      "type": "string",
      "enum": [
        "idle",
        "curious",
        "pleased",
        "concerned"
      ]
    },
    "speech": {
      "description": "Optional compatibility field; speech is disabled in Milestone 1.",
      "type": "null",
      "default": null
    }
  }
}
